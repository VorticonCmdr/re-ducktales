{
  "name": "ducktales-web-port",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "audit:assets": "node scripts/audit-assets.js",
    "test:browser": "playwright test",
    "prepare:analysis": "python3 scripts/prepare-analysis.py",
    "verify:reference": "node scripts/verify-reference.js",
    "verify:build": "node scripts/verify-build.js",
    "verify": "npm run verify:build && npm test && npm run verify:tandy && npm run verify:reference && npm run verify:campaign && npm run verify:visits && npm run verify:loot && npm run verify:investments && npm run verify:startup && npm run verify:ending && npm run verify:rival && npm run verify:atomic && npm run verify:system-controls && npm run verify:departure && npm run verify:flight && npm run verify:flight-course && npm run verify:flight-scene && npm run verify:flight-runtime && npm run verify:cave && npm run verify:mountain && npm run verify:jungle && npm run verify:photography && npm run test:browser && npm run verify:tandy-production",
    "format": "prettier --write src/game scripts/verify-*.js tests/game.test.js tests/browser/*.js index.html playwright.config.js reference/*.json",
    "verify:campaign": "node scripts/verify-campaign.js && npm run verify:map-pointer",
    "verify:departure": "node scripts/verify-departure.js",
    "verify:flight": "node scripts/verify-flight.js",
    "prepare:flight-analysis": "python3 scripts/prepare-flight-analysis.py",
    "verify:flight-course": "node scripts/verify-flight-course.js",
    "verify:flight-scene": "node scripts/verify-flight-scene.js && npm run verify:flight-visible-left-edge",
    "verify:flight-runtime": "node scripts/verify-flight-runtime.js",
    "verify:loot": "node scripts/verify-loot.js",
    "prepare:cave-analysis": "python3 scripts/prepare-cave-analysis.py",
    "verify:cave": "node scripts/verify-cave.js && npm run verify:cave-input",
    "verify:visits": "node scripts/verify-visits.js",
    "prepare:mountain-analysis": "python3 scripts/prepare-mountain-analysis.py",
    "verify:mountain-terrain": "node scripts/verify-mountain-terrain.js",
    "verify:mountain": "node scripts/verify-mountain.js && npm run verify:mountain-input",
    "prepare:jungle-analysis": "python3 scripts/prepare-jungle-analysis.py",
    "verify:jungle": "node scripts/verify-jungle.js && python3 scripts/verify-jungle-oracle.py",
    "prepare:photography-analysis": "python3 scripts/prepare-photography-analysis.py",
    "verify:photography": "node scripts/verify-photography.js && node scripts/verify-photography-runtime.js",
    "verify:investments": "node scripts/verify-investments.js && node scripts/verify-investment-trading.js",
    "prepare:investment-analysis": "python3 scripts/prepare-investment-analysis.py",
    "verify:startup": "node scripts/verify-campaign-startup.js",
    "verify:ending": "node scripts/verify-ending.js && node scripts/verify-credits.js",
    "verify:rival": "node scripts/verify-rival.js && npm run verify:rival-exhausted",
    "verify:atomic": "node scripts/verify-atomic.js",
    "verify:system-controls": "node scripts/verify-system-controls.js && node scripts/verify-money-bin-input.js && node scripts/verify-flight-input.js",
    "verify:cave-input": "node scripts/verify-cave-input.js",
    "verify:mountain-palette": "node scripts/verify-mountain-palette.js",
    "verify:mountain-input": "node scripts/verify-mountain-input.js",
    "verify:rival-exhausted": "node scripts/verify-rival-exhausted.js",
    "verify:flight-visible-left-edge": "node scripts/verify-flight-visible-left-edge.js && node scripts/verify-flight-boundary-replay.js",
    "verify:map-pointer": "node scripts/verify-map-pointer.js",
    "verify:tandy": "node scripts/verify-tandy-driver.js && npm run verify:tandy-envelope && npm run verify:tandy-cues && npm run verify:tandy-sequence && npm run verify:tandy-sequence-cues && npm run verify:tandy-controls && npm run verify:tandy-psg && npm run verify:tandy-noise-cues && npm run verify:tandy-engine && npm run verify:tandy-status && npm run verify:tandy-live && npm run verify:tandy-corpus",
    "verify:tandy-envelope": "node scripts/verify-tandy-envelopes.js",
    "verify:tandy-cues": "node scripts/verify-tandy-cues.js",
    "verify:tandy-sequence": "node scripts/verify-tandy-sequence.js",
    "verify:tandy-sequence-cues": "node scripts/verify-tandy-cues.js --sequence",
    "verify:tandy-controls": "node scripts/verify-tandy-controls.js",
    "verify:tandy-psg": "node scripts/verify-tandy-psg.js",
    "verify:tandy-noise-cues": "node scripts/verify-tandy-cues.js --noise",
    "verify:tandy-engine": "node scripts/verify-tandy-engine.js",
    "verify:tandy-status": "node scripts/verify-tandy-status.js",
    "verify:tandy-live": "node scripts/verify-tandy-live.js",
    "verify:tandy-production": "npm run build && playwright test --config playwright.production.config.js",
    "verify:tandy-corpus": "node scripts/verify-tandy-corpus.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "vite": "8.3.5"
  }
}
