{
  "name": "ducktales-web-port",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "audit:assets": "node scripts/audit-assets.js",
    "test:browser": "playwright test",
    "prepare:analysis": "python3 scripts/prepare-analysis.py",
    "verify:reference": "node scripts/verify-reference.js",
    "verify:build": "node scripts/verify-build.js",
    "verify": "npm run verify:build && npm test && npm run verify:reference && npm run verify:campaign && npm run verify:departure && npm run verify:flight && npm run test:browser && npm run build",
    "format": "prettier --write src/game scripts/verify-*.js tests/game.test.js tests/browser/*.js index.html playwright.config.js reference/*.json",
    "verify:campaign": "node scripts/verify-campaign.js",
    "verify:departure": "node scripts/verify-departure.js",
    "verify:flight": "node scripts/verify-flight.js",
    "prepare:flight-analysis": "python3 scripts/prepare-flight-analysis.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "vite": "8.3.5"
  }
}
